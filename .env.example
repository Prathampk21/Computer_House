NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Supabase browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
BOOTSTRAP_OWNER_EMAIL=owner@example.com

# Server-only secrets. Never expose these in Client Components.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Shop-level defaults; editable values should move into Admin -> Settings.
APP_DEMO_MODE=true
SHOP_DEFAULT_NAME=TechGear Computer Shop
SHOP_DEFAULT_SHORT_NAME=TechGear
SHOP_DEFAULT_PHONE=+91 98765 43210
SHOP_DEFAULT_EMAIL=sales@example.com
SHOP_DEFAULT_ADDRESS=MG Road, Bengaluru, Karnataka
SHOP_DEFAULT_CURRENCY=INR
SHOP_DEFAULT_TIMEZONE=Asia/Kolkata
SHOP_DEFAULT_ATTRIBUTION_DAYS=30
SHOP_PRIMARY_COLOR=#f80050
SHOP_SECONDARY_COLOR=#900030

# WhatsApp Click-to-Chat. Use E.164 digits without +, for example 919876543210.
WHATSAPP_PHONE_NUMBER=

# Optional notification provider placeholders for later integrations.
EMAIL_FROM=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
EMAIL_PROVIDER_WEBHOOK_URL=
WHATSAPP_PROVIDER_WEBHOOK_URL=
WEB_PUSH_PROVIDER_WEBHOOK_URL=
CRON_SECRET=

# Optional local CLI deployment only. Prefer Vercel dashboard env vars for app runtime.
VERCEL_TOKEN=
